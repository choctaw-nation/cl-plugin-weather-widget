{
	"name": "cl-plugin-weather-widget",
	"version": "1.0.2",
	"description": "A plugin that fetches weather data for the Choctaw Landing site.",
	"prettier": "@wordpress/prettier-config",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"engines": {
		"node": ">= 24"
	},
	"author": "Choctaw Nation of Oklahoma",
	"files": [
		"build",
		"inc",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"cl-plugin-weather-widget.php",
		"vendor"
	],
	"scripts": {
		"build": "wp-scripts build",
		"lint:css": "npx stylelint '**/*.scss' '**/*.css' --fix --allow-empty-input",
		"lint:js": "npx eslint --fix",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts build && wp-scripts plugin-zip",
		"start": "wp-scripts start"
	},
	"devDependencies": {
		"@eslint/compat": "^2",
		"@wordpress/api-fetch": "^7.54.0",
		"@wordpress/components": "^40.0.0",
		"@wordpress/dom-ready": "^4.54.0",
		"@wordpress/element": "^8.6.0",
		"@wordpress/eslint-plugin": "^25.10.0",
		"@wordpress/scripts": "^34.2.0",
		"eslint": "^9",
		"globals": "^17",
		"prettier": "npm:wp-prettier@^3",
		"stylelint": "^17",
		"stylelint-config-standard-scss": "^17",
		"stylelint-scss": "^7",
		"typescript": "^6"
	},
	"allowScripts": {
		"core-js-pure@3.49.0": true,
		"fsevents@2.3.3": true,
		"fsevents@2.3.2": true,
		"@parcel/watcher@2.6.0": true,
		"core-js@3.50.0": true,
		"unrs-resolver@1.12.2": true
	}
}
